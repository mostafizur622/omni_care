<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:weightSum="100"
    android:background="#79000000">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="10" >

        <!--<include
            android:layout_width="match_parent"
            layout="@layout/header" />-->
    </LinearLayout>

    <!-- __________________________________________ Buttons  ___________________________________________ -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginLeft="15dp"
        android:layout_marginRight="15dp"
        android:layout_weight="70"
        android:background="#dddddd"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/layoutBg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

         <TextView
             android:layout_width="match_parent"
             android:text="Select Bonuse Items"
             android:padding="5dp"
             android:layout_height="wrap_content"/>







            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">





                <ListView
                    android:id="@+id/ProductListView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginBottom="50dp"
                    android:layout_marginTop="8dp"
                    android:visibility="visible"></ListView>


                <RelativeLayout

                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_alignParentBottom="true"
                    android:layout_marginTop="15dp"
                    android:gravity="center"
                    android:orientation="horizontal">


                    <Button
                        android:id="@+id/CancelButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        android:paddingLeft="30dp"
                        android:paddingRight="30dp"
                        android:background="@drawable/button_shadow"
                        android:layout_marginRight="10dp"
                        android:text="Cancel "
                        android:visibility="visible" />

                    <Button
                        android:id="@+id/NextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        android:paddingLeft="30dp"
                        android:paddingRight="30dp"
                        android:background="@drawable/green_button"
                        android:layout_toRightOf="@+id/CancelButton"
                        android:text="Save"
                        android:visibility="visible" />
                </RelativeLayout>
            </RelativeLayout>
        </LinearLayout>
    </LinearLayout>
    <!-- __________________________________________Footer ___________________________________________ -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="20">

        <!--   <include
            android:layout_width="match_parent"
            layout="@layout/footer" />-->
    </LinearLayout>

</LinearLayout>
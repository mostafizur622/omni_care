<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:weightSum="100" >

     <LinearLayout
         android:layout_width="match_parent"
    android:layout_height="0dp"
    android:background="@color/secondary_color"
    android:weightSum="2"
    android:orientation="horizontal"
    android:layout_weight="10">
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:weightSum="1"
        android:orientation="horizontal"
        android:gravity="left"
        android:layout_weight="1">
        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.3"
            android:src="@drawable/backicon"
            android:layout_margin="15dp"></ImageView>

        <TextView
            android:id="@+id/title_tv"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.7"
            android:autoSizeMaxTextSize="20sp"
            android:autoSizeMinTextSize="12sp"
            android:autoSizeStepGranularity="2sp"
            android:autoSizeTextType="uniform"
            android:gravity="center|left"
            android:text="Incentive Party report"
            android:textColor="@color/white">

        </TextView>

    </LinearLayout>
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:weightSum="1"
        android:gravity="right"
        android:orientation="horizontal"
        android:layout_weight="1">
        <TextView
            android:id="@+id/user_txt_view"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.7"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="15dp"
            android:layout_marginLeft="15dp"
            android:background="@drawable/login_id_bg_shade"
            android:text="273638"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="12sp"
            android:autoSizeMaxTextSize="20sp"
            android:autoSizeStepGranularity="2sp"
            android:textColor="@color/background_white"
            android:textAlignment="center"
            android:gravity="center"></TextView>
        <ImageView
            android:id="@+id/btn_home"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.3"
            android:src="@drawable/home"
            android:layout_margin="15dp">

        </ImageView>


    </LinearLayout>

</LinearLayout>

    <!-- __________________________________________ Buttons  ___________________________________________ -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="90"
        android:orientation="vertical" >

        <LinearLayout
            android:id="@+id/layoutBg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical" >

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginRight="20dp"
                android:orientation="horizontal" >

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="35dp"
                    android:layout_weight="1.5"
                    android:text="Route : "
                    android:gravity="center_vertical|right"
                    android:textSize="14sp"
                    />

                <Spinner
                    android:id="@+id/ThanaSp"
                    android:layout_width="match_parent"
                    android:layout_height="35dp"
                    android:layout_weight="1" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginRight="20dp"
                android:orientation="horizontal" >

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="35dp"
                    android:gravity="center_vertical|right"
                    android:layout_weight="1.5"
                    android:text="Market : "
                    android:textSize="14sp"
                    />

                <Spinner
                    android:id="@+id/MarketSp"
                    android:layout_width="match_parent"
                    android:layout_height="35dp"
                    android:layout_weight="1" />
            </LinearLayout>

            <LinearLayout
            android:id="@+id/llOutlet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginRight="20dp"
            android:orientation="horizontal" >

            <TextView
                android:layout_width="match_parent"
                android:layout_height="35dp"
                android:layout_weight="1.5"
                android:text="Fiscal Year: "
                android:textSize="14sp"
                android:gravity="center_vertical|right"
                />

            <Spinner
                android:id="@+id/spOutlets"
                android:layout_width="match_parent"
                android:layout_height="35dp"
                android:layout_weight="1" />
        </LinearLayout>



            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginRight="20dp"
                android:orientation="horizontal" >

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="35dp"
                    android:layout_weight="1.5"
                    android:text="Bonus Type : "
                    android:textSize="14sp"
                    android:gravity="center_vertical|right"
                    />

                <Spinner
                    android:id="@+id/BonusTypeSp"
                    android:layout_width="match_parent"
                    android:layout_height="35dp"
                    android:layout_weight="1" />
            </LinearLayout>

<Button
    android:id="@+id/search"
    android:layout_width="wrap_content"
    android:gravity="center"
    android:layout_gravity="center_horizontal"
    android:text="search"
    android:textColor="@color/white"
    android:background="@color/bottom_card_color"
    android:layout_height="wrap_content"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@color/background_icon"
                android:orientation="horizontal"
                android:layout_marginTop="10dp"
                android:weightSum="100" >

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="1dp"
                    android:layout_marginTop="1dp"
                    android:layout_weight="27"
                    android:gravity="center_vertical|center_horizontal"
                    android:paddingLeft="3dp"
                    android:text="Outlet"
                    android:textColor="@color/text_color"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="1dp"
                    android:layout_marginTop="1dp"
                    android:layout_weight="25"
                    android:gravity="center_vertical|center_horizontal"
                    android:paddingLeft="3dp"
                    android:text="Product"
                    android:textColor="@color/text_color"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="1dp"
                    android:layout_marginRight="1dp"
                    android:layout_marginTop="1dp"
                    android:layout_weight="17"
                    android:gravity="center_vertical|center_horizontal"
                    android:paddingLeft="3dp"
                    android:text="Target"
                    android:textColor="@color/text_color"
                    android:textSize="12sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"

                    android:layout_marginTop="1dp"
                    android:layout_weight="17"
                    android:gravity="center_vertical|center_horizontal"
                    android:paddingLeft="3dp"
                    android:text="Achieve "
                    android:textColor="@color/text_color"
                    android:textSize="12sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="1dp"
                    android:layout_marginRight="1dp"
                    android:layout_marginTop="1dp"
                    android:layout_weight="14"
                    android:gravity="center_vertical|center_horizontal"
                    android:paddingLeft="3dp"
                    android:text="Stamp"
                    android:textColor="@color/text_color"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ListView
                android:id="@+id/list"
                android:layout_width="fill_parent"
                android:layout_height="match_parent"
                android:layout_marginBottom="5dp"
                android:clickable="false"
                android:listSelector="@android:color/transparent"
                android:scrollbars="none" />
        </LinearLayout>
    </LinearLayout>
    <!-- __________________________________________Footer ___________________________________________ -->



</LinearLayout>